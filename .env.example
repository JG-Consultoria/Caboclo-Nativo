# ============================================================
#  Caboclo Nativo — variáveis de ambiente (back-end)
#  Copie para .env.local e preencha quando integrar de verdade.
# ============================================================

# --- Mercado Pago (Pix + cartão) ---
# Painel: https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# URL pública do site (usada nos webhooks e back_urls do checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Frete (Melhor Envio é o recomendado p/ múltiplas transportadoras) ---
MELHOR_ENVIO_TOKEN=
# CEP de origem (de onde os produtos são despachados)
ORIGEM_CEP=

# --- Banco de dados (quando plugar persistência real) ---
DATABASE_URL=

# Modo de demonstração: usa dados mockados em vez das APIs reais.
# Deixe "true" enquanto o back-end não estiver conectado.
NEXT_PUBLIC_DEMO_MODE=true
